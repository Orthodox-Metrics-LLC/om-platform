# om-dns-guard.env.example  —  EXAMPLE ONLY. NO REAL SECRETS IN THE REPO.
#
# Copy this to the host at /etc/orthodoxmetrics/om-dns-guard.env, fill in the
# real GoDaddy credentials there, and lock it down:
#
#   sudo install -d -m 750 -o root -g root /etc/orthodoxmetrics
#   sudo cp scripts/dns-guard/om-dns-guard.env.example /etc/orthodoxmetrics/om-dns-guard.env
#   sudo chown root:root /etc/orthodoxmetrics/om-dns-guard.env
#   sudo chmod 600       /etc/orthodoxmetrics/om-dns-guard.env
#   sudo nano            /etc/orthodoxmetrics/om-dns-guard.env   # paste real creds
#
# NEVER commit the filled-in file. NEVER echo/print these values.

# ---- GoDaddy Dynamic DNS (required for live A-record updates) ----
# Create at https://developer.godaddy.com/keys (Production key, not OTE/test).
GODADDY_API_KEY=REPLACE_ME
GODADDY_API_SECRET=REPLACE_ME

# ---- DDNS target ----
OM_DDNS_DOMAIN=orthodoxmetrics.com
OM_DDNS_RECORD=@
OM_DDNS_TTL=300

# ---- External health check target ----
OM_HEALTH_DOMAIN=orthodoxmetrics.com
OM_HEALTH_WWW=1
OM_HEALTH_CERT_WARN_DAYS=21
OM_HEALTH_PROTECTED_PATH=/auth/login
# Optional expected marker in the homepage HTML (leave blank to skip):
OM_HEALTH_EXPECT_TITLE=

# ---- Alerting ----
# Email is delivered via the host's local Postfix relay (127.0.0.1:25); no SMTP
# credentials are needed here.
OM_ALERT_EMAIL=info@orthodoxmetrics.com
# Minimum seconds between identical alerts (dedupe throttle):
OM_ALERT_MIN_INTERVAL=3600
# Optional Slack incoming webhook (leave blank to disable):
OM_ALERT_SLACK_WEBHOOK=
# Optional OMAI / OMBrain event-ingestion webhook + bearer token (leave blank):
OM_ALERT_OMAI_WEBHOOK=
OM_ALERT_OMAI_TOKEN=
