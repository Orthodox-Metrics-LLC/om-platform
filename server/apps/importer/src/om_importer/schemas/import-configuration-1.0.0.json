{
  "type": "object",
  "properties": {
    "profile": {
      "enum": [
        "xlsx",
        "docx_paragraphs",
        "docx_table",
        "cemetery_v1",
        "parish_announcements_v1"
      ]
    },
    "resource_name": {
      "type": "string",
      "minLength": 1
    },
    "selection": {
      "type": "object"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "date",
              "partial_date",
              "json"
            ]
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "header": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "header"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string",
                    "pattern": "^[A-Z]{1,3}$"
                  }
                },
                "required": [
                  "column"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "capture": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                  }
                },
                "required": [
                  "capture"
                ],
                "additionalProperties": false
              }
            ]
          },
          "nullable": {
            "type": "boolean"
          },
          "format": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "type",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profile",
    "fields"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:om:import-configuration:1.0.0",
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "xlsx"
          }
        }
      },
      "then": {
        "properties": {
          "selection": {
            "type": "object",
            "properties": {
              "sheet": {
                "type": "string"
              },
              "header_row": {
                "type": "integer",
                "minimum": 1
              },
              "start_row": {
                "type": "integer",
                "minimum": 1
              },
              "end_row": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "docx_table"
          }
        }
      },
      "then": {
        "properties": {
          "selection": {
            "type": "object",
            "properties": {
              "table_index": {
                "type": "integer",
                "minimum": 0
              },
              "header_row": {
                "type": "integer",
                "minimum": 1
              },
              "start_row": {
                "type": "integer",
                "minimum": 1
              },
              "end_row": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "table_index"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "docx_paragraphs"
          }
        }
      },
      "then": {
        "properties": {
          "selection": {
            "type": "object",
            "properties": {
              "start_paragraph": {
                "type": "integer",
                "minimum": 0
              },
              "end_paragraph": {
                "type": "integer",
                "minimum": 0
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "cemetery_v1"
          }
        }
      },
      "then": {
        "properties": {
          "selection": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "parish_announcements_v1"
          }
        }
      },
      "then": {
        "properties": {
          "selection": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
