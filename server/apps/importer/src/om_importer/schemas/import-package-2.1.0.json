    "recurrence": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "fixed",
            "weekday_in_range",
            "weekday_after",
            "pascha_relative",
            "unresolved"
          ]
        },
        "text": {
          "type": "string"
        },
        "month": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 31
        },
        "parameters": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "text",
        "month",
        "day",
        "parameters"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "properties": {
              "month": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31
              },
              "parameters": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "weekday_in_range"
              }
            }
          },
          "then": {
            "properties": {
              "month": {
                "type": "null"
              },
              "day": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "weekday_after"
              }
            }
          },
          "then": {
            "properties": {
              "month": {
                "type": "null"
              },
              "day": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pascha_relative"
              }
            }
          },
          "then": {
            "properties": {
              "month": {
                "type": "null"
              },
              "day": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "properties": {
              "month": {
                "type": "null"
              },
              "day": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "weekday_in_range"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "weekday": {
                    "const": "Sunday"
                  },
                  "start_day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  },
                  "end_day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  },
                  "source_month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  }
                },
                "required": [
                  "weekday",
                  "start_day",
                  "end_day",
                  "source_month"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "weekday_after"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "weekday": {
                    "const": "Sunday"
                  },
                  "after_day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  },
                  "source_month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  }
                },
                "required": [
                  "weekday",
                  "after_day",
                  "source_month"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pascha_relative"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "weekday": {
                    "const": "Sunday"
                  },
                  "ordinal": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  },
                  "reference": {
                    "const": "Pascha"
                  }
                },
                "required": [
                  "weekday",
                  "ordinal",
                  "reference"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
